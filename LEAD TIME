    <script>
        let rawData = [];
        let filteredData = [];
        let chartCategoria, chartMensual;

        window.addEventListener('DOMContentLoaded', () => {
            loadData();
        });

        async function loadData() {
            showLoading('Cargando datos del BI...');
            try {
                const response = await fetch('DATOS_DEL_BI.xlsx');
                if (!response.ok) throw new Error('No se pudo cargar DATOS_DEL_BI.xlsx');
                
                // Para leer Excel en navegador, usamos una librería
                const data = await response.arrayBuffer();
                
                // Parsear con SheetJS (https://sheetjs.com/)
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
                script.onload = () => {
                    const workbook = XLSX.read(data, {type: 'array'});
                    const sheet = workbook.Sheets[workbook.SheetNames[0]];
                    const json = XLSX.utils.sheet_to_json(sheet);
                    
                    rawData = json;
                    console.log(`✅ ${rawData.length} líneas cargadas`);
                    
                    initializeDashboard();
                    hideLoading();
                };
                document.head.appendChild(script);
                
            } catch (error) {
                console.error('Error:', error);
                showLoading(`Error: ${error.message}`);
            }
        }

        function initializeDashboard() {
            filteredData = [...rawData];
            populateFilters();
            updateKPIs();
            updateCharts();
        }

        function populateFilters() {
            const years = [...new Set(rawData.map(d => d.Año).filter(Boolean))].sort();
            const vendors = [...new Set(rawData.map(d => d.DSC_VENDE).filter(Boolean))].sort();
            const clients = [...new Set(rawData.map(d => d.DSC_CLI_AGP_COM).filter(Boolean))].sort();
            const hierarchies = [...new Set(rawData.map(d => d.DSC_JERARQUIA).filter(Boolean))].sort();
            const tipoReps = [...new Set(rawData.map(d => d.COD_TIPO_REP).filter(Boolean))].sort();
            const almacenes = [...new Set(rawData.map(d => d.COD_ALM).filter(Boolean))].sort();

            populateSelect('filterAno', years.map(y => y.toString()));
            populateSelect('filterVende', vendors);
            populateSelect('filterCliente', clients);
            populateSelect('filterJerarquia', hierarchies);
            populateSelect('filterTipoRep', tipoReps);
            populateSelect('filterAlmacen', almacenes);
        }

        function populateSelect(selectId, options) {
            const select = document.getElementById(selectId);
            select.innerHTML = '<option value="">Todos</option>';
            options.forEach(option => {
                const opt = document.createElement('option');
                opt.value = option;
                opt.textContent = option;
                select.appendChild(opt);
            });
        }

        function applyFilters() {
            const filters = {
                año: document.getElementById('filterAno').value,
                vende: document.getElementById('filterVende').value,
                cliente: document.getElementById('filterCliente').value,
                jerarquia: document.getElementById('filterJerarquia').value,
                tipoRep: document.getElementById('filterTipoRep').value,
                almacen: document.getElementById('filterAlmacen').value
            };

            filteredData = rawData.filter(item => {
                return (!filters.año || item.Año == filters.año) &&
                       (!filters.vende || item.DSC_VENDE === filters.vende) &&
                       (!filters.cliente || item.DSC_CLI_AGP_COM === filters.cliente) &&
                       (!filters.jerarquia || item.DSC_JERARQUIA === filters.jerarquia) &&
                       (!filters.tipoRep || item.COD_TIPO_REP === filters.tipoRep) &&
                       (!filters.almacen || item.COD_ALM === filters.almacen);
            });

            updateKPIs();
            updateCharts();
        }

        function resetFilters() {
            document.querySelectorAll('select').forEach(sel => sel.value = '');
            applyFilters();
        }

        function updateKPIs() {
            if (filteredData.length === 0) {
                document.getElementById('kpiLTPromedio').textContent = '--';
                document.getElementById('kpiTotalPedidos').textContent = '--';
                document.getElementById('kpiCompletos').textContent = '--';
                document.getElementById('kpiParciales').textContent = '--';
                return;
            }

            // LT Promedio = AVERAGE(LEAD_TIME_DIAS)
            const leadTimes = filteredData.map(d => parseFloat(d.LEAD_TIME_DIAS)).filter(d => !isNaN(d));
            if (leadTimes.length > 0) {
                const promedio = leadTimes.reduce((a, b) => a + b, 0) / leadTimes.length;
                document.getElementById('kpiLTPromedio').textContent = promedio.toFixed(2);
            }

            // Total Pedidos = DISTINCTCOUNT(CLAVE_LT)
            const uniqueClaves = [...new Set(filteredData.map(d => d.CLAVE_LT))];
            const totalPedidos = uniqueClaves.length;
            document.getElementById('kpiTotalPedidos').textContent = totalPedidos.toLocaleString();

            // % Completos y % Parciales = DISTINCTCOUNT por tipo / DISTINCTCOUNT total
            const completosUnicos = new Set(
                filteredData
                    .filter(d => d.TIPO_ATENCION === 'COMPLETA')
                    .map(d => d.CLAVE_LT)
            ).size;
            
            const parcialesUnicos = new Set(
                filteredData
                    .filter(d => d.TIPO_ATENCION === 'PARCIAL')
                    .map(d => d.CLAVE_LT)
            ).size;
            
            const pctCompletos = (completosUnicos / totalPedidos * 100);
            const pctParciales = (parcialesUnicos / totalPedidos * 100);
            
            document.getElementById('kpiCompletos').textContent = pctCompletos.toFixed(1) + '%';
            document.getElementById('kpiParciales').textContent = pctParciales.toFixed(1) + '%';
        }

        function updateCharts() {
            updateChartCategoria();
            updateChartMensual();
        }

        function updateChartCategoria() {
            const ctx = document.getElementById('chartCategoria').getContext('2d');
            const groupedData = {};
            filteredData.forEach(item => {
                const key = item.DSC_JERARQUIA || 'Sin categoría';
                if (!groupedData[key]) groupedData[key] = [];
                const lt = parseFloat(item.LEAD_TIME_DIAS);
                if (!isNaN(lt)) groupedData[key].push(lt);
            });

            const labels = [], data = [];
            Object.entries(groupedData).forEach(([key, values]) => {
                if (values.length > 0) {
                    labels.push(key);
                    data.push(values.reduce((a, b) => a + b, 0) / values.length);
                }
            });

            const combined = labels.map((label, i) => ({ label, value: data[i] }));
            combined.sort((a, b) => b.value - a.value);
            const top10Labels = combined.slice(0, 10).map(c => c.label);
            const top10Data = combined.slice(0, 10).map(c => c.value);

            if (chartCategoria) chartCategoria.destroy();
            chartCategoria = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: top10Labels,
                    datasets: [{
                        label: 'LT Promedio (días)',
                        data: top10Data,
                        backgroundColor: 'rgba(184, 134, 11, 0.8)',
                        borderColor: 'rgba(139, 105, 20, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true },
                        x: { ticks: { maxRotation: 45, minRotation: 45 } }
                    }
                }
            });
        }

        function updateChartMensual() {
            const ctx = document.getElementById('chartMensual').getContext('2d');
            const monthlyData = {};
            filteredData.forEach(item => {
                if (item.Mes && item.Año) {
                    const key = `${item.Año}-${String(item.Mes).padStart(2, '0')}`;
                    if (!monthlyData[key]) monthlyData[key] = [];
                    const lt = parseFloat(item.LEAD_TIME_DIAS);
                    if (!isNaN(lt)) monthlyData[key].push(lt);
                }
            });

            const labels = [], promedios = [], medianas = [];
            Object.keys(monthlyData).sort().forEach(key => {
                const values = monthlyData[key];
                if (values.length > 0) {
                    labels.push(key);
                    const avg = values.reduce((a, b) => a + b, 0) / values.length;
                    promedios.push(avg);
                    const sorted = [...values].sort((a, b) => a - b);
                    const middle = Math.floor(sorted.length / 2);
                    const median = sorted.length % 2 === 0 
                        ? (sorted[middle - 1] + sorted[middle]) / 2 
                        : sorted[middle];
                    medianas.push(median);
                }
            });

            if (chartMensual) chartMensual.destroy();
            chartMensual = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'LT Promedio',
                            data: promedios,
                            borderColor: '#1e40af',
                            backgroundColor: 'rgba(30, 64, 175, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointBackgroundColor: '#1e40af',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        },
                        {
                            label: 'LT Mediana',
                            data: medianas,
                            borderColor: '#dc2626',
                            backgroundColor: 'rgba(220, 38, 38, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointBackgroundColor: '#dc2626',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { usePointStyle: true, padding: 15 }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true },
                        x: { ticks: { maxRotation: 45, minRotation: 45 } }
                    }
                }
            });
        }

        function showLoading(text) {
            document.getElementById('loading').classList.add('active');
            document.getElementById('loadingText').textContent = text;
        }

        function hideLoading() {
            document.getElementById('loading').classList.remove('active');
        }

        function reloadData() {
            location.reload();
        }
    </script>
</body>
</html>
